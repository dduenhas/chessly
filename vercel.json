{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://educom-portal.pages.dev https://*.pages.dev https://*.workers.dev"
        }
      ]
    }
  ]
}
